{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "kyc_reviews": {
      ".read": true,
      ".write": true
    },

    "entrepreneurs": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "founders": {
      ".read": "auth != null",
      "$uid": {
        "profile": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "stats": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "bankingDetails": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "pitches": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "payments": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "sample_orders": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "investor_queries": {
          "$queryId": {
            ".write": "auth != null && (auth.uid == $uid || newData.child('investorId').val() == auth.uid || data.child('investorId').val() == auth.uid)"
          }
        },
        "chat_index": {
          "$chatId": {
            ".read": "auth != null && (auth.uid == $uid || data.child('investorId').val() == auth.uid || newData.child('investorId').val() == auth.uid)",
            ".write": "auth != null && (auth.uid == $uid || newData.child('investorId').val() == auth.uid || data.child('investorId').val() == auth.uid)"
          }
        }
      }
    },

    "investors": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('founders').child(auth.uid).exists())",
        "profile": {
          ".read": "auth != null && (auth.uid == $uid || root.child('founders').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid"
        },
        "investments": {
          "$pitchId": {
            ".read": "auth != null && (auth.uid == $uid || root.child('founders').child(auth.uid).exists())",
            ".write": "auth != null && (auth.uid == $uid || (root.child('pitches').child($pitchId).child('transactions').child($uid).child('founderId').val() == auth.uid))"
          }
        },
        "payment_desk": {
          "$pitchId": {
            ".read": "auth != null && (auth.uid == $uid || root.child('founders').child(auth.uid).exists() || data.child('founderId').val() == auth.uid)",
            ".write": "auth != null && (auth.uid == $uid || (root.child('pitches').child($pitchId).child('transactions').child($uid).child('founderId').val() == auth.uid) || data.child('founderId').val() == auth.uid)"
          }
        },
        "my_portfolio": {
          "$pitchId": {
            ".write": "auth != null && (auth.uid == $uid || (root.child('pitches').child($pitchId).child('transactions').child($uid).child('founderId').val() == auth.uid))"
          }
        },
        "chats": {
          "$chatId": {
            ".read": "auth != null && (auth.uid == $uid || data.child('founderId').val() == auth.uid || newData.child('founderId').val() == auth.uid || root.child('founders').child(auth.uid).exists())",
            ".write": "auth != null && (auth.uid == $uid || data.child('founderId').val() == auth.uid || newData.child('founderId').val() == auth.uid)"
          }
        }
      }
    },

    "pitches": {
      "$pitchId": {
        ".read": "auth != null",
        "transactions": {
          "$investorId": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid == $investorId || root.child('founders').child(auth.uid).child('pitches').child($pitchId).exists() || data.child('founderId').val() == auth.uid)"
          }
        }
      }
    },

    "chats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "wholesalers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "community_posts": {
      ".read": true,
      ".write": "auth != null"
    },

    "messages": {
      "$messageId": {
        ".read": "auth != null && (data.child('fromId').val() == auth.uid || data.child('toId').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('fromId').val() == auth.uid) || data.child('fromId').val() == auth.uid || (data.child('toId').val() == auth.uid && newData.child('read').val() == true))"
      }
    },

    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null && (!data.exists() ? newData.child('createdBy').val() == auth.uid : data.child('createdBy').val() == auth.uid)"
      }
    },

    "group_messages": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "sample_orders": {
      ".indexOn": ["founderId", "investorId"],
      "$orderId": {
        ".read": "auth != null && (data.child('investorId').val() == auth.uid || data.child('founderId').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('investorId').val() == auth.uid) || (data.exists() && data.child('founderId').val() == auth.uid && newData.child('founderId').val() == auth.uid))"
      }
    },

    "payments": {
      "$paymentId": {
        ".read": "auth != null && (data.child('investorId').val() == auth.uid || data.child('founderId').val() == auth.uid)",
        ".write": "auth != null && newData.child('investorId').val() == auth.uid"
      }
    },

    "video_lounge": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "followers": {
      "$followerId": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('followerId').val() == auth.uid"
      }
    },

    "points": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },

    "user_directory": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "platform_stats": {
      ".read": true,
      ".write": true
    },

    "landing_testimonials": {
      ".read": true,
      ".write": true
    },

    "investor_feed": {
      ".read": true,
      "$ideaId": {
        ".write": "auth != null && newData.child('entrepreneurUid').val() == auth.uid"
      }
    },

    "founder_problems": {
      ".read": "auth != null",
      "$problemId": {
        ".write": "auth != null && newData.child('founderId').val() == auth.uid"
      }
    },

    "registered_emails": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "!data.exists() && newData.hasChild('uid')"
      }
    },

    "registered_phones": {
      "$phoneKey": {
        ".read": "auth != null",
        ".write": "!data.exists() && newData.hasChild('uid')"
      }
    },

    "registered_cnics": {
      "$cnicKey": {
        ".read": "auth != null",
        ".write": "!data.exists() && newData.hasChild('uid')"
      }
    },

    "subdomains": {
      "$slug": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('owner_uid').val() == auth.uid) || (data.exists() && data.child('owner_uid').val() == auth.uid))"
      }
    },

    "business_owners": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",

        "profile": {
          ".read": true
        },

        "website_settings": {
          ".read": true
        },

        "products": {
          ".read": true,
          "$productId": {
            ".write": "auth != null && auth.uid == $uid",
            "reviews": {
              "$reviewUid": {
                ".write": "!data.exists() && newData.hasChildren(['customer_name', 'rating', 'review_text', 'timestamp']) && newData.child('customer_name').isString() && newData.child('customer_name').val().length > 0 && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('review_text').isString() && newData.child('review_text').val().length > 0 && newData.child('timestamp').isNumber() && root.child('business_owners').child($uid).child('orders').child($reviewUid).child('status').val() == 'delivered' && root.child('business_owners').child($uid).child('orders').child($reviewUid).child('items').child('item_1').child('product_id').val() == $productId"
              }
            }
          }
        },

        "reviews": {
          ".read": true,
          "$orderId": {
            ".write": "!data.exists() && newData.hasChildren(['name', 'email', 'product', 'order_id', 'rating', 'text', 'sentiment', 'createdAt']) && newData.child('order_id').val() == $orderId && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && root.child('business_owners').child($uid).child('orders').child($orderId).exists() && root.child('business_owners').child($uid).child('orders').child($orderId).child('status').val() == 'delivered' && root.child('business_owners').child($uid).child('orders').child($orderId).child('customer_email').val().toLowerCase() == newData.child('email').val().toLowerCase()"
          }
        },

        "visitor_daily": {
          ".read": "auth != null && auth.uid == $uid",
          "$dayId": {
            ".write": "(!data.exists() && newData.isNumber() && newData.val() == 1) || (data.exists() && newData.isNumber() && newData.val() == data.val() + 1)"
          }
        },

        "dashboard_stats": {
          ".read": "auth != null && auth.uid == $uid",
          "visitor_count": {
            ".write": "(!data.exists() && newData.isNumber() && newData.val() == 1) || (data.exists() && newData.isNumber() && newData.val() == data.val() + 1) || (auth != null && auth.uid == $uid)"
          },
          "total_reviews": {
            ".write": "(!data.exists() && newData.isNumber() && newData.val() == 1) || (data.exists() && newData.isNumber() && newData.val() == data.val() + 1) || (auth != null && auth.uid == $uid)"
          },
          "total_orders_pending": {
            ".write": "(!data.exists() && newData.isNumber()) || (data.exists() && newData.isNumber()) || (auth != null && auth.uid == $uid)"
          }
        },

        "orders": {
          ".read": "auth != null && auth.uid == $uid",
          "$orderId": {
            ".write": "(auth != null && auth.uid == $uid) || (!data.exists() && newData.hasChildren(['customer_name', 'customer_email', 'total_amount', 'items', 'status', 'createdAt']) && newData.child('status').val() == 'pending')"
          }
        },

        "kyc_documents": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        },

        "financials": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    }
  }
}
